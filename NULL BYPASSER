local function updateActivateVisual()
	if isActivated then
		ActivateBtn.BackgroundColor3 = GREEN
		ActivateBtn.Text = "DEACTIVATE"
		ActivateStroke.Color = GREEN

		CompactActivate.BackgroundColor3 = GREEN
		CompactActivate.Text = "DEACTIVATE"
	else
		ActivateBtn.BackgroundColor3 = RED
		ActivateBtn.Text = "ACTIVATE"
		ActivateStroke.Color = RED

		CompactActivate.BackgroundColor3 = RED
		CompactActivate.Text = "ACTIVATE"
	end
end

local function onActivate()
	isActivated = not isActivated
	updateActivateVisual()
end

