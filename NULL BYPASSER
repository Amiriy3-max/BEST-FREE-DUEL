local function SetMenuSize(sizeName)
	local size = MenuSizes[sizeName]
	if not size then return end

	CurrentMenuSize = sizeName

	if isMinimized then
		return
	end

	TweenService:Create(
		Main,
		TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{
			Size = size,
			Position = UDim2.new(
				0.5,
				-size.X.Offset / 2,
				0.5,
				-size.Y.Offset / 2
			)
		}
	):Play()
end

