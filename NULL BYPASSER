-- MINIMIZE
--==================================================

local function setNormalVisible(value)
	Header.Visible = value
	Content.Visible = value
	ActivateBtn.Visible = value
	HeaderFiller.Visible = value
	Divider.Visible = value
	MinimizeBtn.Visible = value
end

local function minimize()
	if isMinimized then return end

	isMinimized = true
	setNormalVisible(false)
	CompactContainer.Visible = true

	TweenService:Create(
		Main,
		TweenInfo.new(0.38, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{
			Size = UDim2.new(0, 280, 0, 110),
			Position = UDim2.new(0.5, -140, 0.5, -55)
		}
	):Play()
end

local function expand()
	if not isMinimized then return end

	isMinimized = false
	CompactContainer.Visible = false
	setNormalVisible(true)

	local size = MenuSizes[CurrentMenuSize]

	TweenService:Create(
		Main,
		TweenInfo.new(0.42, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{
			Size = size,
			Position = UDim2.new(
				0.5,
				-size.X.Offset / 2,
				0.5,
				-size.Y.Offset / 2
			)
		}
	):Play()
end

MinimizeBtn.MouseButton1Click:Connect(minimize)
ExpandBtn.MouseButton1Click:Connect(expand)

